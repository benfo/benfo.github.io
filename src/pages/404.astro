---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config/site';
---

<Layout title={`404 — ${siteConfig.name}`}>
  <Header />

  <main class="flex-1 flex flex-col justify-center py-20 animate-fade-in">
    <p class="font-mono text-xs uppercase tracking-widest text-zinc-400 dark:text-zinc-500">
      404 &middot; Page not found
    </p>
    <h1 class="mt-3 text-2xl sm:text-3xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
      Nothing here.
    </h1>
    <p class="mt-3 text-sm sm:text-base text-zinc-600 dark:text-zinc-400 max-w-md">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <div class="mt-6">
      <a
        href="/"
        class="inline-flex items-center gap-2 rounded-lg bg-zinc-900 px-4 py-2 text-sm font-medium text-zinc-50 transition-colors hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-200"
      >
        &larr; Back to {siteConfig.domain}
      </a>
    </div>
  </main>

  <Footer />
</Layout>
