---
import { siteConfig } from '../config/site';

const currentYear = new Date().getFullYear();
---

<footer class="mt-auto pt-16 pb-12 border-t border-zinc-200/70 dark:border-zinc-800/70 text-xs text-zinc-500 dark:text-zinc-500">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <p>
      &copy; {currentYear} {siteConfig.name}. All rights reserved.
    </p>
    <p class="font-mono text-[11px] text-zinc-400 dark:text-zinc-600">
      {siteConfig.domain}
    </p>
  </div>
</footer>
